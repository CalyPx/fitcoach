# Server-side only — used by api/analyze-meal.ts. Never expose this to the client.
ANTHROPIC_API_KEY=

# Local testing note: `vite dev` does not serve the /api directory. Use
# `vercel dev` (after `npm i -g vercel` and `vercel link`) to run the
# analyze-meal function locally, or deploy to Vercel. Without it, the meal
# logging feature automatically falls back to manual macro entry.
